{
  "name": "creanote",
  "version": "0.3.2",
  "description": "Easily create organized notes.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "release": "changeset version",
    "manual-publish": "changeset publish",
    "clean": "rimraf dist && rimraf node_modules",
    "ci": "npm run format:check && npm run typecheck && npm run build && npm run test"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "bin": {
    "creanote": "dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elitalpa/creanote.git"
  },
  "keywords": [
    "notes",
    "cli",
    "note-taking",
    "command-line",
    "productivity",
    "shell",
    "bash",
    "local-first",
    "note-taker",
    "markdown"
  ],
  "author": "elitalpa",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/elitalpa/creanote/issues"
  },
  "homepage": "https://github.com/elitalpa/creanote#readme",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^26.0.1",
    "date-fns": "4.4.0",
    "prettier": "^3.9.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^15.0.0",
    "openai": "^6.45.0",
    "simple-git": "^3.36.0"
  }
}
